# Public URL of the deployed site (used for SEO / Open Graph)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Where contact-form submissions are delivered. Any endpoint that accepts a
# JSON POST works: an n8n webhook, Formspree, Make, Zapier, your own API.
# Without it the form falls back to opening the visitor's email app.
CONTACT_WEBHOOK_URL=
